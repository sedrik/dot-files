[user]
    email = sir.sedrik@gmail.com
    name = Fredrik Park
[push]
    default = current
    autoSetupRemote = true
[core]
    editor = nvim
    autocrlf = input
    excludesfile = /home/sedrik/.gitignore
[diff]
    tool = nvim -d
[merge]
    tool = nvim -d
[pull]
    rebase = false
[init]
    defaultBranch = development
[fetch]
    prune = true
[alias]
	rmb = ! git branch --merged | grep -Ev \"(^\\*|main)\" | xargs git branch -d
[rerere]
	enabled = true
